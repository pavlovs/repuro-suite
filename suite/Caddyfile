{
	admin off
}

:8080 {
	handle /healthz {
		respond "ok" 200
	}

	# Basic auth on everything EXCEPT /healthz and the agent API when a Bearer
	# token is presented. Agent endpoints (/cockpit/api/agent/*) are role-gated
	# in the backend (agent_only / token validation), so skipping Caddy basic
	# auth for them is safe ONLY because the bypass also requires an
	# Authorization: Bearer header — no human mutating endpoint lives under
	# /api/agent/*. See cockpit/ai/SPEC-agent-skills-repo.md §2 (Option B).
	@needsAuth {
		not path /healthz
		not {
			path /cockpit/api/agent/*
			header Authorization "Bearer *"
		}
	}
	basic_auth @needsAuth {
		roman {$AUTH_ROMAN_HASH}
		florian {$AUTH_FLORIAN_HASH}
		# investor {$AUTH_INVESTOR_HASH}  # add when Strada access is provisioned (defer)
	}

	# Investor isolation: a logged-in `investor` user is confined to /investor — 403 elsewhere.
	# Inert until the investor basic_auth line above is enabled; load-bearing once Strada is provisioned.
	@investor_outside {
		expression {http.auth.user.id} == "investor"
		not path /investor /investor/*
	}
	respond @investor_outside 403

	header {
		X-Frame-Options DENY
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer
		Strict-Transport-Security "max-age=63072000; includeSubDomains"
	}

	handle /api/whoami {
		header Content-Type "application/json"
		respond `{"user":"{http.auth.user.id}"}` 200
	}

	handle /favicon.ico {
		respond 204
	}

	handle /shared.css {
		header Cache-Control "no-cache, must-revalidate"
		root * /app/suite/static
		file_server
	}

	handle / {
		header Cache-Control "no-cache, must-revalidate"
		root * /app/suite/static
		file_server
	}

	handle /allex {
		redir /allex/ permanent
	}
	handle /deals {
		redir /deals/ permanent
	}
	handle /cockpit {
		redir /cockpit/ permanent
	}
	handle /investor {
		redir /investor/ permanent
	}

	handle_path /allex/* {
		reverse_proxy localhost:8081
	}

	handle_path /deals/* {
		reverse_proxy localhost:8082
	}

	handle_path /cockpit/* {
		reverse_proxy localhost:8083 {
			header_up X-Remote-User {http.auth.user.id}
		}
	}

	handle_path /investor/* {
		reverse_proxy localhost:8084 {
			header_up X-Remote-User {http.auth.user.id}
		}
	}
}
