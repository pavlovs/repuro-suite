# Copy this file to .env and fill in your keys.
# Never commit .env to version control.

# Anthropic Claude API — REQUIRED for classification (M6)
# Copy your key from: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...

# OpenRegister.de — REQUIRED for ownership enrichment (M7)
# Sign up at: https://openregister.de → API settings
# 500 free credits to start. ~10 credits per company (search + detail + owners).
OPENREGISTER_API_KEY=...

# Hunter.io — optional, email discovery (M9)
# Get from: https://hunter.io → account → API key
# Free: 25 searches/month. Starter: $49/month for 500.
HUNTER_API_KEY=...

# Google Maps Places API — optional, future city-based discovery
# Get from: https://console.cloud.google.com → Maps → Places API
# Free tier: $200/month credit.
GOOGLE_MAPS_API_KEY=...

# OffeneRegister.de — NO KEY NEEDED
# Free SQL API: https://db.offeneregister.de
# Used as free first step before OpenRegister for GF name lookup.

# Database paths -- defaults point to data/ in this directory (on shared OneDrive).
# Only override if you need a local copy (e.g., handelsregister.db is 2.6GB).
# PIPELINE_DB_PATH=          (defaults to data/pipeline.db)
# KNOWLEDGE_BASE_PATH=       (defaults to data/knowledge_base.db)
# HANDELSREGISTER_DB_PATH=C:\Users\[you]\Documents\repuro-data\handelsregister.db
