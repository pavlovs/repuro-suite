{
	admin off
}

:8080 {
	handle /healthz {
		respond "ok" 200
	}

	# Basic auth on everything EXCEPT /healthz and the agent API when a Bearer
	# token is presented. Agent endpoints (/cockpit/api/agent/*) are role-gated
	# in the backend (agent_only / token validation), so skipping Caddy basic
	# auth for them is safe ONLY because the bypass also requires an
	# Authorization: Bearer header — no human mutating endpoint lives under
	# /api/agent/*. See cockpit/ai/SPEC-agent-skills-repo.md §2 (Option B).
	@needsAuth {
		not path /healthz
		not path /diag
		not {
			path /cockpit/api/agent/*
			header Authorization "Bearer *"
		}
	}
	basic_auth @needsAuth {
		roman {$AUTH_ROMAN_HASH}
		florian {$AUTH_FLORIAN_HASH}
		investor {$AUTH_INVESTOR_HASH}
	}

	header {
		X-Frame-Options DENY
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer
		Strict-Transport-Security "max-age=63072000; includeSubDomains"
	}

	# Trailing-slash redirects — top-level redir runs before handle blocks,
	# so the catch-all landing page handler cannot swallow these paths.
	redir /allex /allex/ permanent
	redir /deals /deals/ permanent
	redir /cockpit /cockpit/ permanent
	redir /investor /investor/ permanent
	redir /research /research/ permanent

	# Investor isolation: investor user is confined to /investor — 403 elsewhere.
	# Must be a handle block (not respond) and placed BEFORE other handle/handle_path
	# blocks because Caddy evaluates handle blocks in order — first match wins.
	@investor_outside {
		expression {http.auth.user.id} == "investor"
		not path /investor /investor/*
	}
	handle @investor_outside {
		header Content-Type "text/html"
		respond `<!DOCTYPE html>
<html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<title>Repuro Suite</title>
<style>
*{box-sizing:border-box;margin:0;padding:0}
body{font-family:'Inter',-apple-system,BlinkMacSystemFont,'Segoe UI',system-ui,sans-serif;
background:#f0f2f5;color:#111827;display:flex;align-items:center;justify-content:center;
min-height:100vh;-webkit-font-smoothing:antialiased}
.card{background:#fff;border-radius:16px;box-shadow:0 1px 3px rgba(0,0,0,.08);
padding:48px 56px;text-align:center;max-width:420px}
.mark{width:48px;height:48px;border-radius:12px;background:#0891B2;display:inline-flex;
align-items:center;justify-content:center;margin-bottom:24px}
.mark svg{width:28px;height:28px}
h1{font-size:20px;font-weight:700;margin-bottom:8px}
p{font-size:14px;color:#4b5563;line-height:1.55;margin-bottom:24px}
a{display:inline-block;font-size:13px;font-weight:600;color:#0891B2;
text-decoration:none;padding:8px 20px;border:1.5px solid #0891B2;border-radius:8px;
transition:background .15s,color .15s}
a:hover{background:#0891B2;color:#fff}
</style></head><body>
<div class="card">
<div class="mark"><svg viewBox="0 0 32 32" fill="none"><rect x="7" y="17.5" width="7.5" height="7.5" rx="2" fill="white"/><rect x="12.25" y="12.25" width="7.5" height="7.5" rx="2" fill="white" opacity=".78"/><rect x="17.5" y="7" width="7.5" height="7.5" rx="2" fill="white"/></svg></div>
<h1>Investor Access Only</h1>
<p>Your account has access to the Investor Room. The internal suite requires a team login.</p>
<a href="/investor/">Go to Investor Room</a>
</div></body></html>` 403
	}

	handle /api/whoami {
		header Content-Type "application/json"
		respond `{"user":"{http.auth.user.id}"}` 200
	}

	handle /diag {
		header Content-Type "text/html"
		respond `<!DOCTYPE html><html><body><h1>Suite Diag</h1><p>Caddy is alive.</p><p><a href="/cockpit/">Cockpit</a> | <a href="/allex/">ALLEX</a> | <a href="/deals/">Deals</a></p></body></html>` 200
	}

	handle /favicon.ico {
		respond 204
	}

	handle_path /allex/* {
		forward_auth localhost:8083 {
			uri /api/authz?module=allex
			header_up X-Remote-User {http.auth.user.id}
		}
		reverse_proxy localhost:8081
	}

	handle_path /deals/* {
		forward_auth localhost:8083 {
			uri /api/authz?module=dealroom
			header_up X-Remote-User {http.auth.user.id}
		}
		reverse_proxy localhost:8082
	}

	handle_path /cockpit/* {
		reverse_proxy localhost:8083 {
			header_up X-Remote-User {http.auth.user.id}
		}
	}

	handle_path /investor/* {
		reverse_proxy localhost:8084 {
			header_up X-Remote-User {http.auth.user.id}
		}
	}

	handle_path /research/* {
		header Cache-Control "no-cache, must-revalidate"
		root * /app/suite/static/research
		file_server
	}

	handle /shared.css {
		header Cache-Control "no-cache, must-revalidate"
		root * /app/suite/static
		file_server
	}

	handle / {
		header Cache-Control "no-cache, must-revalidate"
		root * /app/suite/static
		file_server
	}
}
